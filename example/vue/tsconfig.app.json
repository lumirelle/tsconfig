{
  "extends": "@lumirelle/tsconfig/vue",
  "compilerOptions": {
    // Please adjust the path aliases to match your bundler's configuration.
    "paths": {
      "~": ["./"],
      "~/*": ["./*"]
    },
    // Include types you need, if you are using Vite, you can leave below as is, otherwise, please replace "vite/client" with the types you need.
    "types": ["vite/client"]
  },
  // Only include your project's source files who are expected to run in the browser, also d.ts generated by tools, e.g. `auto-imports.d.ts` & `src/components/Xxx.vue`.
  // Especially, `vite.config.ts` is required for provide vite client types, you can remove it if you are not using Vite.
  "include": ["*.d.ts", "vite.config.ts", "src/**/*"]
}
