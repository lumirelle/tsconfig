{
  "name": "@lumirelle/tsconfig",
  "type": "module",
  "version": "0.1.4",
  "packageManager": "bun@1.3.14",
  "description": "Lumirelle's opinionated TypeScript config",
  "author": "Lumirelle <shabbyacc@outlook.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/lumirelle",
  "homepage": "https://github.com/lumirelle/tsconfig#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumirelle/tsconfig.git"
  },
  "bugs": "https://github.com/lumirelle/tsconfig/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    "./ts": "./tsconfig.ts.json",
    "./vue": "./tsconfig.vue.json",
    "./package.json": "./package.json"
  },
  "files": [
    "internal",
    "tsconfig.ts.json",
    "tsconfig.vue.json"
  ],
  "workspaces": {
    "packages": [],
    "catalogs": {
      "dev": {
        "bumpp": "^11.1.0",
        "typescript": "^6.0.3",
        "vue": "^3.5.35"
      },
      "types": {
        "@types/node": "^25.9.1",
        "bun-types": "^1.3.14"
      },
      "check": {
        "@antfu/eslint-config": "^9.0.0",
        "@arethetypeswrong/cli": "^0.18.3",
        "@lumirelle/oxlint-config": "^0.7.0",
        "eslint": "^10.4.1",
        "eslint-plugin-oxlint": "^1.68.0",
        "knip": "^6.15.0",
        "nano-staged": "^1.0.2",
        "oxlint": "^1.68.0",
        "oxlint-tsgolint": "^0.23.0",
        "publint": "^0.3.21"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "mise run prepare"
  },
  "peerDependencies": {
    "typescript": ">=6.0.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:check",
    "@arethetypeswrong/cli": "catalog:check",
    "@lumirelle/oxlint-config": "catalog:check",
    "@types/node": "catalog:types",
    "bumpp": "catalog:dev",
    "bun-types": "catalog:types",
    "eslint": "catalog:check",
    "eslint-plugin-oxlint": "catalog:check",
    "knip": "catalog:check",
    "nano-staged": "catalog:check",
    "oxlint": "catalog:check",
    "oxlint-tsgolint": "catalog:check",
    "publint": "catalog:check",
    "typescript": "catalog:dev",
    "vue": "catalog:dev"
  },
  "overrides": {
    "typescript": "catalog:dev"
  },
  "nano-staged": {
    "*": [
      "oxlint --no-error-on-unmatched-pattern",
      "eslint"
    ]
  }
}
