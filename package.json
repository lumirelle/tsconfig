    "@lumirelle/oxlint-config": "^0.13.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "bumpp": "^12.2.0",
    "changelogithub": "^15.0.4",
    "eslint": "^10.8.1",
    "eslint-plugin-oxlint": "^1.78.0",
    "knip": "^6.32.2",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pkg-pr-new": "^0.0.87",
    "publint": "^0.3.23",
    "taze": "^20.0.1",
