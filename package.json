{
  "name": "@lumirelle/tsconfig",
  "type": "module",
  "version": "0.1.4",
  "packageManager": "aube@1.17.1",
  "description": "Lumirelle's opinionated TypeScript config",
  "author": "Lumirelle <shabbyacc@outlook.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/lumirelle",
  "homepage": "https://github.com/lumirelle/tsconfig#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumirelle/tsconfig.git"
  },
  "bugs": "https://github.com/lumirelle/tsconfig/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    "./ts": "./tsconfig.ts.json",
    "./vue": "./tsconfig.vue.json",
    "./package.json": "./package.json"
  },
  "files": [
    "internal",
    "tsconfig.ts.json",
    "tsconfig.vue.json"
  ],
  "engines": {
    "node": ">22",
    "bun": ">1"
  },
  "workspaces": {
    "packages": [],
    "catalogs": {
      "dev": {
        "typescript": "^6.0.3",
        "vue": "^3.5.35"
      },
      "types": {
        "@types/bun": "^1.3.14"
      },
      "check": {
        "@antfu/eslint-config": "^9.0.0",
        "@lumirelle/oxlint-config": "^0.7.0",
        "eslint": "^10.4.1",
        "eslint-plugin-oxlint": "^1.68.0",
        "knip": "^6.16.0",
        "oxlint": "^1.68.0",
        "oxlint-tsgolint": "^0.23.0"
      },
      "test": {
        "@vitest/coverage-v8": "^4.1.8",
        "vitest": "^4.1.8"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "typescript": ">=6.0.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:check",
    "@lumirelle/oxlint-config": "catalog:check",
    "@types/bun": "catalog:types",
    "@vitest/coverage-v8": "catalog:test",
    "eslint": "catalog:check",
    "eslint-plugin-oxlint": "catalog:check",
    "knip": "catalog:check",
    "oxlint": "catalog:check",
    "oxlint-tsgolint": "catalog:check",
    "typescript": "catalog:dev",
    "vitest": "catalog:test",
    "vue": "catalog:dev"
  },
  "overrides": {
    "typescript": "catalog:dev"
  }
