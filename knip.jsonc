{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreFiles": [
    // Test fixtures
    "test/fixtures/**"
  ],
  "ignoreDependencies": [
    // Quality
    "@lumirelle/oxlint-config",
    "@arethetypeswrong/cli",
    "publint",
    "vue-tsc",
    // Test fixtures prerequisites
    "vue",
